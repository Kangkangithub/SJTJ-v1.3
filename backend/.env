# 服务器配置
PORT=3001
NODE_ENV=development

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# SQLite数据库配置（当前使用）
SQLITE_PATH=data/herb-knowledge.db

# Neo4j数据库配置（完整模式使用，当前已注释）
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=neo4j123456

# MongoDB数据库配置（完整模式使用，当前已注释）
# MONGODB_URI=mongodb://localhost:27017/military-knowledge
# MONGODB_TEST_URI=mongodb://localhost:27017/military-knowledge-test

# Redis配置（完整模式使用，当前已注释）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# 文件上传配置
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=warn
LOG_FILE=logs/app.log

# API限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000

